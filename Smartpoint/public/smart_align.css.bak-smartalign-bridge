.smartalign-task-button {
  margin: 4px 0;
}

.smartalign-task-button i,
.smartalign-toolbar .btn:not(.smartalign-icon-button) i:first-child,
.smartalign-back i:first-child,
.smartalign-panel-head .btn:not(.smartalign-icon-button) i:first-child {
  margin-right: 6px;
}

.smartalign-dashboard {
  max-width: 900px;
}

.smartalign-loading {
  padding: 24px;
}

.smartalign-app {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 96px);
  min-height: 0;
  overflow: hidden;
  padding: 8px 0 0;
}

.smartalign-topbar {
  align-items: center;
  background: #fff;
  border: 1px solid #d8dee4;
  border-radius: 4px;
  box-sizing: border-box;
  display: flex;
  flex: 0 0 auto;
  min-height: 56px;
  padding: 10px;
}

.smartalign-topbar > * + *,
.smartalign-toolbar > * + *,
.smartalign-map-actions > * + *,
.smartalign-panel-actions > * + *,
.smartalign-point-strip > * + * {
  margin-left: 8px;
}

.smartalign-topbar h3 {
  margin: 0 0 3px;
}

.smartalign-back {
  flex: 0 0 auto;
}

.smartalign-subtitle,
.smartalign-muted,
.smartalign-meta,
.smartalign-help,
.smartalign-count {
  color: #667085;
}

.smartalign-toolbar {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  margin-left: 0;
}

.smartalign-toolbar .smartalign-3d-toolbar-controls {
  align-items: flex-start;
  display: flex;
  flex: 1 1 auto;
  gap: 8px;
  min-width: 0;
}

.smartalign-back + .smartalign-toolbar {
  margin-left: 8px;
}

.smartalign-topbar .btn,
.smartalign-panel-head .btn {
  align-items: center;
  display: inline-flex;
  height: 34px;
  line-height: 1;
}

.smartalign-icon-button {
  justify-content: center;
  min-width: 34px;
  padding-left: 0;
  padding-right: 0;
}

.smartalign-workspace {
  display: grid;
  flex: 1 1 auto;
  gap: 12px;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  margin-top: 10px;
  min-height: 0;
}

.smartalign-workspace-3d {
  grid-template-columns: minmax(0, 1fr);
  margin-top: 8px;
}

.smartalign-panel {
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 4px;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  padding: 0;
}

.smartalign-panel-head {
  align-items: center;
  border-bottom: 1px solid #d8dee4;
  box-sizing: border-box;
  display: flex;
  gap: 10px;
  justify-content: space-between;
  min-height: 44px;
  padding: 5px 10px;
}

.smartalign-panel-head h4 {
  font-size: 16px;
  margin: 0;
}

.smartalign-panel-actions {
  align-items: center;
  display: flex;
}

.smartalign-image-stage {
  background: #20242b;
  border: 0;
  cursor: default;
  display: block;
  flex: 1 1 auto;
  -ms-overflow-style: none;
  min-height: 0;
  overflow: auto;
  padding: 12px;
  position: relative;
  scrollbar-width: none;
  touch-action: none;
  user-select: none;
}

.smartalign-image-stage::-webkit-scrollbar {
  display: none;
}

.smartalign-image-stage.panning {
  cursor: grabbing;
}

.smartalign-map {
  background: #eef2f6;
  border: 0;
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
  position: relative;
  width: 100%;
}

.smartalign-3d-stage {
  background: #20242b;
  display: flex;
  flex: 1 1 auto;
  min-height: 0;
  position: relative;
}

.smartalign-3d-viewer {
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
}

.smartalign-3d-viewer canvas {
  display: block;
}

.smartalign-3d-status {
  background: rgba(32, 36, 43, 0.86);
  border-radius: 4px;
  bottom: 10px;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  left: 10px;
  max-width: calc(100% - 20px);
  padding: 6px 8px;
  position: absolute;
}

.smartalign-3d-gizmo-tools {
  display: flex;
  gap: 6px;
}

.smartalign-3d-gizmo-tools .btn.active {
  background: #2c3e50;
  border-color: #2c3e50;
  color: #fff;
}

.smartalign-3d-table-wrap {
  border-top: 1px solid #d8dee4;
  flex: 0 0 auto;
  max-height: 185px;
  overflow: auto;
}

.smartalign-3d-table {
  border-collapse: collapse;
  font-size: 12px;
  width: 100%;
}

.smartalign-3d-table th,
.smartalign-3d-table td {
  border-bottom: 1px solid #e5e7eb;
  padding: 5px 6px;
  text-align: left;
  vertical-align: middle;
}

.smartalign-3d-table th {
  background: #f8fafc;
  color: #50657c;
  font-weight: 700;
  position: sticky;
  top: 0;
  z-index: 1;
}

.smartalign-3d-table tr.active td {
  background: #eef6ff;
}

.smartalign-3d-height {
  border: 1px solid #d0d5dd;
  border-radius: 4px;
  max-width: 82px;
  padding: 3px 5px;
}

.smartalign-3d-placement {
  flex: 0 0 auto;
  padding: 10px;
}

.smartalign-3d-toolbar-controls .smartalign-3d-placement {
  border-top: 0;
  flex: 1 1 auto;
  min-width: 520px;
  padding: 0;
}

.smartalign-3d-placement-grid {
  display: grid;
  gap: 8px;
  grid-template-columns: repeat(5, minmax(72px, 1fr));
}

.smartalign-3d-toolbar-controls .smartalign-3d-placement-grid {
  grid-template-columns: repeat(5, minmax(88px, 150px));
}

.smartalign-3d-placement-field {
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin: 0;
}

.smartalign-3d-placement-field span {
  color: #50657c;
  font-size: 12px;
  font-weight: 700;
}

.smartalign-3d-placement-field input {
  border: 1px solid #d0d5dd;
  border-radius: 4px;
  height: 30px;
  padding: 3px 5px;
  width: 100%;
}

.smartalign-3d-nudge {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}

.smartalign-3d-toolbar-controls .smartalign-3d-nudge {
  margin-top: 6px;
}

.smartalign-map-actions {
  align-items: center;
  display: flex;
}

.smartalign-map-status {
  color: #50657c;
  flex: 1 1 auto;
  font-size: 13px;
  font-weight: 600;
  min-width: 0;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.smartalign-map-layer-picker,
.smartalign-orthophoto-picker,
.smartalign-preview-opacity-picker {
  position: relative;
}

.smartalign-map-layer-menu,
.smartalign-orthophoto-menu,
.smartalign-preview-opacity-menu {
  background: #fff;
  border: 1px solid #d0d5dd;
  border-radius: 6px;
  box-shadow: 0 8px 24px rgba(16, 24, 40, 0.18);
  display: none;
  min-width: 180px;
  padding: 6px;
  position: absolute;
  right: 0;
  top: calc(100% + 4px);
  z-index: 5000;
}

.smartalign-map-layer-picker.open .smartalign-map-layer-menu,
.smartalign-orthophoto-picker.open .smartalign-orthophoto-menu,
.smartalign-preview-opacity-picker.open .smartalign-preview-opacity-menu {
  display: block;
}

.smartalign-orthophoto-menu {
  min-width: 220px;
}

.smartalign-preview-opacity-menu {
  align-items: center;
  gap: 8px;
  min-width: 190px;
}

.smartalign-preview-opacity-picker.open .smartalign-preview-opacity-menu {
  display: flex;
}

.smartalign-preview-opacity-menu input {
  flex: 1 1 auto;
  min-width: 110px;
}

.smartalign-preview-opacity-menu span {
  color: #50657c;
  font-size: 12px;
  font-weight: 700;
  min-width: 38px;
  text-align: right;
}

.smartalign-map-layer-option,
.smartalign-orthophoto-option,
.smartalign-orthophoto-empty {
  background: transparent;
  border: 0;
  border-radius: 4px;
  color: #2c3e50;
  display: block;
  font-size: 13px;
  font-weight: 600;
  padding: 7px 9px;
  text-align: left;
  width: 100%;
}

.smartalign-map-layer-option:hover,
.smartalign-map-layer-option:focus,
.smartalign-orthophoto-option:hover,
.smartalign-orthophoto-option:focus {
  background: #eef3f7;
  outline: none;
}

.smartalign-map-layer-option.active,
.smartalign-orthophoto-option.active {
  background: #2563eb;
  color: #fff;
}

.smartalign-orthophoto-off {
  color: #c0392b;
}

.smartalign-orthophoto-empty {
  color: #7b8794;
  cursor: default;
}

.smartalign-map-marker-wrap {
  background: transparent;
  border: 0;
}

.smartalign-map-marker {
  align-items: center;
  background: #2c3e50;
  border: 1.5px solid #8a96a3;
  border-radius: 50% 50% 50% 0;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
  color: #fff;
  display: inline-flex;
  font-size: 12px;
  font-weight: 700;
  height: 24px;
  justify-content: center;
  line-height: 1;
  transform: rotate(-45deg);
  user-select: none;
  width: 24px;
}

.smartalign-map-marker.active {
  background: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.22), 0 1px 6px rgba(0, 0, 0, 0.35);
}

.smartalign-image-stage.disabled {
  background: #f2f4f7;
}

.smartalign-image-frame {
  display: inline-block;
  line-height: 0;
  position: relative;
}

.smartalign-image-frame img {
  display: block;
  height: 100%;
  object-fit: fill;
  user-select: none;
  width: 100%;
}

.smartalign-empty {
  color: #667085;
  padding: 24px;
}

.smartalign-marker {
  align-items: center;
  background: #2c3e50;
  border: 1.5px solid #8a96a3;
  border-radius: 50% 50% 50% 0;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
  color: #fff;
  cursor: default;
  display: inline-flex;
  font-size: 12px;
  font-weight: 700;
  height: 24px;
  justify-content: center;
  line-height: 1;
  padding: 0;
  position: absolute;
  transform: rotate(-45deg);
  transform-origin: 0 100%;
  user-select: none;
  width: 24px;
  z-index: 3;
}

.smartalign-marker.active {
  background: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.22), 0 1px 6px rgba(0, 0, 0, 0.35);
}

.smartalign-marker-delete {
  background: #fff;
  border: 0;
  border-radius: 4px;
  box-shadow: 0 1px 5px rgba(0, 0, 0, 0.22);
  color: #c0392b;
  font-size: 12px;
  font-weight: 700;
  line-height: 1;
  padding: 6px 10px;
  position: absolute;
  transform: translate(-50%, -100%);
  z-index: 4;
}

.smartalign-pin-label {
  display: block;
  text-shadow: 0 1px 1px rgba(0, 0, 0, 0.35);
  transform: rotate(45deg);
}

.smartalign-point-strip {
  align-items: center;
  display: flex;
  flex: 1 1 auto;
  gap: 8px;
  justify-content: center;
  min-height: 34px;
  min-width: 0;
  overflow: hidden;
}

.smartalign-point-chip {
  align-items: center;
  background: #8a96a3;
  border: 2px solid #8a96a3;
  border-radius: 50%;
  color: #fff;
  display: inline-flex;
  flex: 0 0 auto;
  font-size: 13px;
  font-weight: 700;
  height: 30px;
  justify-content: center;
  line-height: 1;
  padding: 0;
  width: 30px;
}

.smartalign-point-chip.complete {
  border-color: #98a2b3;
}

.smartalign-point-chip.good {
  border-color: #12b76a;
}

.smartalign-point-chip.ok {
  border-color: #f79009;
}

.smartalign-point-chip.bad {
  border-color: #f04438;
}

.smartalign-point-chip.active {
  background: #2563eb;
  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.16);
}

.smartalign-meta {
  font-size: 12px;
  min-height: 18px;
  padding-top: 4px;
}

.smartalign-help {
  margin-bottom: 8px;
}

.smartalign-points-table {
  margin-bottom: 0;
}

.smartalign-points-table tr.active td {
  background: #eff8ff;
}

.smartalign-points-table tr.smartalign-point-quality-good td {
  background: #ecfdf3;
}

.smartalign-points-table tr.smartalign-point-quality-ok td {
  background: #fffaeb;
}

.smartalign-points-table tr.smartalign-point-quality-bad td {
  background: #fef3f2;
}

.smartalign-points-table tr.active td {
  box-shadow: inset 3px 0 0 #1570ef;
}

.smartalign-result {
  align-items: center;
  display: flex;
  gap: 8px;
  justify-content: flex-end;
  min-width: 0;
}

.smartalign-result-links {
  align-items: center;
  display: flex;
  flex: 0 0 auto;
  gap: 6px;
}

.smartalign-result-summary {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.smartalign-3d-block {
  border-top: 1px solid #d0d5dd;
  margin-top: 12px;
  padding-top: 10px;
}

.smartalign-3d-block-alone {
  border-top: 0;
  margin-top: 0;
  padding-top: 0;
}

.smartalign-3d-diagnostics {
  margin-top: 10px;
}

.smartalign-3d-summary {
  border-left: 3px solid #98a2b3;
  color: #344054;
  font-size: 12px;
  padding: 6px 8px;
}

.smartalign-3d-summary.available {
  border-left-color: #12b76a;
  background: #ecfdf3;
}

.smartalign-3d-summary.blocked {
  border-left-color: #f79009;
  background: #fffaeb;
}

.smartalign-3d-ortho {
  color: #667085;
  font-size: 12px;
  margin-top: 8px;
}

.smartalign-3d-assets {
  display: grid;
  gap: 6px;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  margin-top: 8px;
}

.smartalign-3d-asset {
  background: #fff;
  border: 1px solid #d0d5dd;
  font-size: 12px;
  min-height: 64px;
  padding: 8px;
}

.smartalign-3d-asset span {
  color: #475467;
  display: inline-block;
  font-weight: 700;
  margin-right: 6px;
}

.smartalign-3d-asset strong {
  color: #344054;
}

.smartalign-3d-asset.found {
  border-left: 3px solid #12b76a;
}

.smartalign-3d-asset.missing {
  border-left: 3px solid #98a2b3;
  color: #667085;
}

.smartalign-3d-diagnostics ul {
  color: #667085;
  font-size: 12px;
  margin: 8px 0 0;
  padding-left: 18px;
}

.smartalign-replace-note {
  color: #667085;
  font-size: 12px;
  margin-top: 8px;
}

.smartalign-busy {
  opacity: 0.72;
  pointer-events: none;
}

@media (max-width: 900px) {
  .smartalign-app {
    height: auto;
    overflow: visible;
  }

  .smartalign-topbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .smartalign-toolbar {
    justify-content: flex-start;
    margin-left: 0;
  }

  .smartalign-workspace {
    grid-template-columns: 1fr;
  }

  .smartalign-image-stage {
    min-height: 260px;
  }
}
